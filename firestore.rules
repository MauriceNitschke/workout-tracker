rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's training dataset lives below /users/{Firebase Auth UID}.
    // This includes meta/state and all record subcollections such as exercises,
    // workoutTemplates, workoutExecutions, and recoveryActivities.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Deny access to every document outside an authenticated user's own tree.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
